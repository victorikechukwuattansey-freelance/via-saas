# VIA SaaS — environment configuration (placeholders only; never commit real values)
#
# Each app/package resolves DATABASE_URL from its own .env file or the process
# environment (see packages/database/index.ts — startup fails fast when missing).

# PostgreSQL connection string (all apps + packages)
# Local dev default comes from docker-compose.yml (postgres:15-alpine on port 5430).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Storefront (apps/storefront) — public store identifier used to resolve the
# merchant organization for the storefront API. Not a secret, but env-driven
# so the code contains no hardcoded organization identifiers.
NEXT_PUBLIC_STORE_SLUG=your-store-slug
