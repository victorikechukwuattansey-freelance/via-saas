// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. AUTHENTICATION & TENANCY
// ==========================================

enum PlanTier {
  STARTER
  GROWTH
  SCALE
}

enum AuditAction {
  CREATE_PRODUCT
  UPDATE_PRODUCT
  INVITE_STAFF
  RESOLVE_ORDER
  UPDATE_SETTINGS
  // P1-B (X-2 order-side): canonical order-lifecycle audit events.
  CREATE_ORDER
  CANCEL_ORDER
  PAYMENT_RECORDED
  // P1-C: staff/membership, invitation lifecycle, location lifecycle, and
  // organization-switch audit events (C-D6 + C-D22b, approved).
  UPDATE_STAFF
  REMOVE_STAFF
  RESCIND_INVITE
  CREATE_LOCATION
  UPDATE_LOCATION
  ARCHIVE_LOCATION
  SWITCH_ORG
  // P1-D (PD-D5, R-5): inventory-adjustment and stock-count lifecycle events.
  // Added by migration D3 in a file that never references the new values —
  // PostgreSQL cannot use an enum value in the transaction that adds it.
  ADJUST_INVENTORY
  STOCK_COUNT_START
  STOCK_COUNT_APPROVE
  STOCK_COUNT_CANCEL
}

// P1-B (D-D): how payment was taken at checkout. Records the method only —
// explicitly NOT a payment-processing integration. Nullable because orders
// created before this field existed remain valid (NULL = "recorded before
// the field existed"; inferable from paymentStatus semantics).
enum PaymentMethod {
  CASH
  TRANSFER
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  phone         String?      @unique
  passwordHash  String
  name          String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  memberships   Membership[]
  sessions      Session[]
  auditLogs      AuditLog[]
  stockActions  StockMovement[] // Audit trail of who did what
  // P1-D (P1-22): count lifecycle attribution.
  stockCountsCreated  StockCount[] @relation("StockCountCreatedBy")
  stockCountsApproved StockCount[] @relation("StockCountApprovedBy")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  // P1-17 (C-D13/C-D10 roadmap): server-authoritative active organization.
  // Nullable = legacy sessions (resolve via the eligible-first fallback);
  // possibly stale = first-class state re-verified at resolution (C11).
  activeOrganizationId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id             String     @id @default(cuid())
  name           String
  subscriptionPlan PlanTier @default(STARTER)
  createdAt      DateTime   @default(now())

  stores         Store[]
  memberships    Membership[]
  products       Product[]
  variants       ProductVariant[]
  categories     Category[]
  orders         Order[]
  customers      Customer[]
  apiKeys        ApiKey[]
  auditLogs      AuditLog[]
  staffInvites   StaffInvite[]
  orderCounter   OrderCounter?
  // P1-D (P1-22): stock counts opened by this organization.
  stockCounts    StockCount[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  // P1-C (C-D1b): constrained by the DB CHECK `membership_role_canonical`
  // to the three canonical values; the TS union in @via-saas/core is the
  // application-level gate.
  role           String       // "OWNER", "MANAGER", "STAFF"
  allowedLocationIds String[] // Empty array = access to all locations
  
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  name           String       // e.g., "Shipbubble Integration"
  publicKey      String       @unique
  secretKeyHash  String
  lastUsedAt     DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Secure staff onboarding: a hashed, single-use, time-limited invite token.
// The raw token is shown to the inviting OWNER exactly once and is never
// stored or logged. Replaces the removed hardcoded default password.
model StaffInvite {
  id                 String    @id @default(cuid())
  organizationId     String
  name               String
  email              String
  role               String // "MANAGER" | "STAFF"
  allowedLocationIds String[]
  tokenHash          String    @unique
  expiresAt          DateTime
  acceptedAt         DateTime?
  // P1-C (P1-15): terminal revocation (manual rescission or supersession).
  // A revoked invite is never acceptable, regardless of other fields (§8.1).
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Per-organization sequential counter for collision-safe order numbers.
// The row is incremented inside the checkout transaction, so concurrent
// checkouts serialize on the row lock and numbers are unique per org.
model OrderCounter {
  organizationId String @id
  lastNumber     Int    @default(1001)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ==========================================
// 2. STORE & LOCATIONS
// ==========================================

model Store {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  // P1-C (C18 amendment, owner-approved): creation timestamp — the primary
  // deterministic-ordering key for automatic location selection.
  createdAt      DateTime     @default(now())
  // Public identifier used by the storefront plane to resolve the
  // organization (replaces hardcoded organization/location ids).
  slug           String?      @unique

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locations      Location[]
}

model Location {
  id             String       @id @default(cuid())
  storeId        String
  name           String
  // P1-C (C18 amendment, owner-approved): creation timestamp — the primary
  // deterministic-ordering key for automatic location selection (no reorder
  // on rename/archive).
  createdAt      DateTime     @default(now())
  // P1-C (P1-16): soft deactivation. NULL = active. Archived locations are
  // excluded from new activity (checkout, FULFILL, adjustments, invites,
  // access grants) but ALL history is retained; restore clears the field.
  archivedAt     DateTime?
  
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventory      Inventory[]
  orders         Order[]
  carts          Cart[]
  stockMovements StockMovement[]
  // P1-D (P1-22): counts are per-location; archived locations cannot open or
  // approve a count (§6.3 C-D20 alignment).
  stockCounts    StockCount[]

  // P1-C (C-D11a, audit F-01): per-store name uniqueness. Declared here to
  // match the DB index created by migration 20261116130001
  // (`Location_storeId_name_key`) — Prisma generates the identical name for
  // this attribute, so schema and migration history agree.
  @@unique([storeId, name])
}

// ==========================================
// 3. CATALOGUE & INVENTORY
// ==========================================

model Product {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         String       @default("PUBLISHED") // "DRAFT", "PUBLISHED"
  // Soft archival (P1-A): archived products are excluded from the storefront
  // and POS but all order/inventory history is retained. Deletion is guarded
  // in core (only products never referenced by orders/movements may be deleted).
  archivedAt     DateTime?
  categoryId     String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  images         ProductImage[]

  @@index([organizationId])
  @@index([categoryId])
}

// Organization-scoped product categories (P1-A). Names are unique per org.
model Category {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// URL-only product images (P1-A, decision D-3): no upload/storage provider —
// merchants reference externally hosted images. Tenant isolation is enforced
// through the parent product's organizationId (M1 parent-chain pattern).
model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  url        String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id             String       @id @default(cuid())
  productId      String
  // Denormalized from Product so SKU/barcode uniqueness can be enforced
  // PER ORGANIZATION (P1-A decision D-2) instead of globally. Backfilled
  // from Product in migration 20261115120000_p1a_catalogue.
  organizationId String
  sku            String?
  barcode        String?
  name           String       // e.g., "Red / Medium"
  sellingPrice   Decimal      @db.Decimal(10, 2)
  costPrice      Decimal      @db.Decimal(10, 2)

  // P1-D (P1-21, PD-D6/R-8): nullable low-stock threshold. NULL = disabled
  // (legacy semantics preserved; no backfill). Evaluated READ-TIME — low when
  // quantity <= threshold at a location (0 = flag out-of-stock only, since
  // quantities are never negative). Negative values are rejected server-side.
  // Archived products are excluded from low-stock indicators (R-9).
  lowStockThreshold Int?

  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
  inventory      Inventory[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  stockMovements StockMovement[]
  // P1-D (P1-22): one line per counted variant per count.
  stockCountLines StockCountLine[]

  // Per-organization uniqueness: two different merchants may both use
  // "RED-001". NULL sku/barcode values are unlimited (Postgres NULLs are
  // distinct in unique constraints).
  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([productId])
}

model Inventory {
  id          String         @id @default(cuid())
  locationId  String
  variantId   String
  quantity    Int            @default(0)
  
  location    Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([locationId, variantId])
}

enum StockMovementType {
  SALE
  TRANSFER
  ADDED
  REMOVED
  RETURN
}

model StockMovement {
  id          String            @id @default(cuid())
  locationId  String
  variantId   String
  actorId     String?           // The staff member who made the change
  type        StockMovementType
  quantity    Int               // Positive for added, negative for removed
  referenceId String?           // e.g., Order ID if type is SALE
  createdAt   DateTime          @default(now())

  location    Location          @relation(fields: [locationId], references: [id])
  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  actor       User?             @relation(fields: [actorId], references: [id])

  // actorId is null for system-originated movements (e.g., storefront
  // checkout) — never a fake user id.
  @@index([locationId])
  @@index([variantId])
}

// P1-D (P1-22, §6.3): physical stock count at ONE location.
// State machine: OPEN → APPROVED (terminal) | OPEN → CANCELLED (terminal, no
// stock effect). Counts are never deleted and never leave a terminal state;
// approval/cancellation are guarded by a conditional status update inside the
// transaction, which makes them retry-safe and double-submit-safe (PD-AC19).
enum StockCountStatus {
  OPEN
  APPROVED
  CANCELLED
}

model StockCount {
  id             String           @id @default(cuid())
  organizationId String
  locationId     String
  // Sequential per organization, allocated inside the opening transaction
  // under an Organization row lock — the org-scoped counter pattern of
  // OrderCounter, applied without a second counter table.
  countNumber    Int
  status         StockCountStatus @default(OPEN)
  createdById    String
  approvedById   String?
  openedAt       DateTime         @default(now())
  approvedAt     DateTime?
  cancelledAt    DateTime?

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("StockCountCreatedBy", fields: [createdById], references: [id])
  approvedBy     User?            @relation("StockCountApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  lines          StockCountLine[]

  // Sequential numbers are unique per org (defense in depth for the
  // allocation in openStockCount).
  @@unique([organizationId, countNumber])
  @@index([organizationId])
  @@index([locationId])
  @@index([status])
}

// Exactly one line per variant that held an Inventory row at the count's
// location when it opened (R-4 auto-population; there is no manual line-add
// path in P1-D). Three distinct quantities: expectedQty (opening snapshot,
// informational), countedQty (the physical observation), and the
// approval-time balance the corrective delta is computed from (PD-AC20).
model StockCountLine {
  id          String  @id @default(cuid())
  countId     String
  variantId   String
  expectedQty Int
  // NULL until entered; approval requires every line to be counted (§6.3).
  countedQty  Int?

  count       StockCount     @relation(fields: [countId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  // R-1 defense in depth: at most one line per (count, variant), so an
  // application defect can never yield two corrective movements for the same
  // count/variant pair (PD-AC28).
  @@unique([countId, variantId])
  @@index([countId])
}

// ==========================================
// 4. CARTS (SHOPPER PLANE)
// ==========================================

model Cart {
  id           String     @id @default(cuid())
  token        String     @unique // The X-Cart-Token
  locationId   String
  status       String     @default("ACTIVE") // "ACTIVE", "INACTIVE", "CHECKED_OUT"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  location     Location   @relation(fields: [locationId], references: [id])
  items        CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])
}

// ==========================================
// 5. ORDERS & CUSTOMERS
// ==========================================

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders         Order[]

  // Phone is the per-organization customer identifier (see core/customers.ts).
  // The DB-level unique constraint makes customer creation race-safe.
  @@unique([organizationId, phone])
  @@index([organizationId])
}

enum OrderStatus {
  PENDING
  ATTENTION // Stock conflict
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model Order {
  id             String        @id @default(cuid())
  organizationId String
  locationId     String
  customerId     String?
  
  orderNumber    String        // e.g., "ORD-1001"
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(UNPAID)
  totalAmount    Decimal       @db.Decimal(10, 2)

  // P1-B (D-D): persisted checkout method (CASH/TRANSFER). NULL for orders
  // created before this field existed — existing records remain valid.
  paymentMethod  PaymentMethod?

  // P1-B (D-C): org-scoped checkout idempotency. The key is supplied by the
  // POS (client-generated UUID per submission attempt); the fingerprint is a
  // server-computed canonical hash of the meaningful order input. Both are
  // written in the SAME transaction as the order, so a failed checkout rolls
  // all three back — the key remains usable for a corrected retry.
  // Public API requests WITHOUT a key keep M1 retry behavior (keyed only).
  idempotencyKey   String?
  requestFingerprint String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id])
  location       Location      @relation(fields: [locationId], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  items          OrderItem[]

  // Order numbers are allocated from OrderCounter per organization and are
  // DB-unique per org — random generation is no longer used.
  @@unique([organizationId, orderNumber])
  @@index([organizationId, createdAt])

  // D-C: uniqueness is per organization, so keys are never reused across
  // merchants. NULL keys (unkeyed public-API orders) are unlimited.
  @@unique([organizationId, idempotencyKey])
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  variantId   String
  quantity    Int
  unitPrice   Decimal        @db.Decimal(10, 2) // Price at time of sale

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  // P1-B (D-G): nullable ONLY for system-origin public storefront/API checkout
  // events — action = CREATE_ORDER with server-stamped top-level
  // metadata.source = "STOREFRONT_API". Every other event requires a real
  // authenticated actor (no synthetic system user exists). Enforced by the
  // central audit helper (packages/core/src/audit.ts) and, as defense in
  // depth, by the CHECK constraint in migration 20261116120001_p1b_orders_b.
  actorId        String?
  action         AuditAction
  targetId       String?     // ID of the product, order, or staff member affected
  metadata       Json?       // Flexible payload (e.g., old vs new values)
  createdAt      DateTime    @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId])
}
